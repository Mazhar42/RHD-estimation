# /opt/rhd-ces/.env on the VPS -- copy this file there, fill it in, and
# `chmod 600 .env`. Never commit the real one.

# --- Public address ---------------------------------------------------------
# The address users open. TLS and the hostname are handled by the host's
# nginx (deploy/nginx/estimation.rhdbridge.com.conf).
PUBLIC_URL=https://estimation.rhdbridge.com
COOKIE_SECURE=true
# The loopback port the host's nginx proxies to. Must be free on the VPS and
# match proxy_pass in the nginx site file. (8001 = old RHD, 8002 = webmap.)
HTTP_PORT=8003

# --- Images (set once by hand) ----------------------------------------------
# Lowercase GitHub owner name.
BACKEND_IMAGE=ghcr.io/mazhar42/rhd-estimation-backend
FRONTEND_IMAGE=ghcr.io/mazhar42/rhd-estimation-frontend
# deploy.sh keeps these up to date; "latest" is fine before the first deploy.
BACKEND_TAG=latest
FRONTEND_TAG=latest

# --- Secrets ----------------------------------------------------------------
# Generate each with:  openssl rand -hex 32
# (hex only: DB_PASSWORD is embedded in a connection URL, so avoid @ : / #)
SECRET_KEY=
DB_PASSWORD=
# Optional: lets an external scheduler call POST /api/admin/purge-expired.
# The VPS cron job (bootstrap-vps.sh) runs the purge directly and doesn't
# need it.
CRON_SECRET=

# --- Database -----------------------------------------------------------------
DB_USER=rhd
DB_NAME=rhd_ces

# --- Tuning -------------------------------------------------------------------
# Worker processes; each can hold DB_POOL_SIZE + DB_MAX_OVERFLOW connections.
WEB_CONCURRENCY=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Backups ------------------------------------------------------------------
BACKUP_KEEP_DAYS=14
